    "The primary ListenScrobbler identity for submissions, charts, and social music data.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad principal de ListenScrobbler para envíos, gráficos y datos musicales sociales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die primäre ListenScrobbler-Identität für Einsendungen, Charts und Social Music-Daten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La principale identité ListenScrobbler pour les soumissions, les graphiques et les données de musique sociale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identità primaria di ListenScrobbler per presentazioni, grafici e dati di musica sociale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿、チャート、およびソーシャルミュージックデータのための主要なListenScrobblerアイデンティティ。"
          }
        },
        "pl": {
          "stringUnit": {
