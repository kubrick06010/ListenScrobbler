    "Retry later. If this persists, inspect compatibility API status and credentials.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva a intentarlo más tarde. Si esto persiste, inspeccione el estado y las credenciales de la API de compatibilidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry später. Wenn dies weiterhin besteht, überprüfen Sie den Status und die Anmeldeinformationen von API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez plus tard. Si cela persiste, inspecter la compatibilité API statut et les références."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry più tardi. Se questo persiste, ispezionare la compatibilità API stato e credenziali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後退します。 これにより、互換性のある API ステータスと認証情報をチェックします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Później. W przypadku utrzymywania się takiego stanu należy sprawdzić status API i jego kwalifikacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a tentar mais tarde. Se isso persistir, inspecione o status e credenciais API compatibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращайся позже. Если это сохраняется, проверьте статус совместимости API и учетные данные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry senare. Om detta kvarstår, inspektera kompatibilitet API status och referenser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry daha sonra. Eğer bu devam ederse, uyumluluk API durumu ve kimlikleri kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后复试. 如果这种情况继续存在,则检查兼容性API状态和证书."
          }
        }
      }
    },
    "Retry later. If this persists, verify API credentials and connectivity.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva a intentarlo más tarde. Si esto persiste, verifique las credenciales y la conectividad de la API."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry später. Wenn dies weiterhin besteht, überprüfen Sie API Anmeldeinformationen und Konnektivität."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez plus tard. Si cela persiste, vérifiez les identifiants API et la connectivité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry più tardi. Se questo persiste, verifica le credenziali e la connettività API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後退します。 これにより、API の認証情報と接続性を確認することができます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Później. W przypadku utrzymywania się takiego stanu rzeczy należy zweryfikować referencje API i łączność."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a tentar mais tarde. Se isso persistir, verifique credenciais e conectividade API."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращайся позже. Если это сохраняется, проверьте учетные данные API и возможность подключения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry senare. Om detta kvarstår, verifiera API-uppgifter och anslutning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry daha sonra. Eğer bu devam ederse API kimliklerini ve bağlantılarını doğrulayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后复试. 如果这种情况继续存在,则核实API证书和连接。"
          }
        }
      }
    },
