    "Charts, pins, followers, similar users, and recommendations use open identifiers you can take elsewhere.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas, pines, seguidores, usuarios similares y recomendaciones usan identificadores abiertos que puedes llevar a otros sitios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Charts, Pins, Follower, ähnliche Benutzer und Empfehlungen verwenden offene Identifikatoren, die Sie an anderer Stelle verwenden können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les graphiques, les pins, les suiveurs, les utilisateurs similaires et les recommandations utilisent des identifiants ouverts que vous pouvez prendre ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I grafici, i perni, i seguaci, gli utenti simili e le raccomandazioni usano gli identificatori aperti che puoi prendere altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャート、ピン、フォロワー、同様のユーザー、および推奨事項は、他の場所で使用できるオープン識別子を使用します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty, szpilki, zwolennicy, podobni użytkownicy i rekomendacje używają otwartych identyfikatorów, które można wziąć gdzie indziej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gráficos, pinos, seguidores, usuários similares e recomendações usam identificadores abertos que você pode levar para outro lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диаграммы, контакты, подписчики, аналогичные пользователи и рекомендации используют открытые идентификаторы, которые вы можете взять в другом месте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagram, stift, följare, liknande användare och rekommendationer använder öppna identifierare du kan ta någon annanstans."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafikler, pins, takipçiler, benzer kullanıcılar ve öneriler başka yerlerde yapabileceğiniz açık tanımlayıcılar kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图表,标注,追随者,相似的用户,以及建议使用您可以在别处取得的开放式标识符."
          }
        }
      }
    },
    "Check network connectivity. Queued listens will retry automatically.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique la conectividad de la red. Las escuchas en cola se volverán a intentar automáticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
