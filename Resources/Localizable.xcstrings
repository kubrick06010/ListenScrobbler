    "ListenScrobbler submits listens to ListenBrainz and uses official ListenBrainz logo assets from the MetaBrainz Design System.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenScrobbler envía escuchas a ListenBrainz y usa recursos oficiales del logotipo de ListenBrainz del sistema de diseño de MetaBrainz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenScrobbler sendet Hörer von ListenBrainz und verwendet offizielle ListenBrainz-Logo-Assets aus dem MetaBrainz Design System."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenScrobbler soumet les écoutes à ListenBrainz et utilise les actifs officiels du logo ListenBrainz du système de conception MetaBrainz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenScrobbler invia ascolto ad ListenBrainz e utilizza le attività ufficiali del logo ListenBrainz del MetaBrainz Design System."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenScrobbler は ListenBrainz にリスニングし、公式の ListenBrainz ロゴアセットを MetaBrainz デザイン システムから使用しています。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenScrobbler przedstawia słucha ListenBrainz i używa oficjalnych aktywów logo ListenBrainz z MetaBrainz Design System."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenScrobbler envia escutas para ListenBrainz e usa ativos oficiais do logotipo ListenBrainz do MetaBrainz Design System."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenScrobbler отправляет сообщения ListenBrainz и использует официальные ресурсы логотипа ListenBrainz из системы дизайна MetaBrainz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenScrobbler lämnar in lyssnar på ListenBrainz och använder officiella ListenBrainz-logotyptillgångar från MetaBrainz Design System."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenScrobbler, ListenBrainz'u dinler ve MetaBrainz Design System'ten resmi ListenBrainz logo varlıklarını kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenScrobbler提交听ListenBrainz并使用MetaBrainz设计系统的官方ListenBrainz标志资产."
          }
        }
      }
    },
