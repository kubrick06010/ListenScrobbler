    "Queue is empty. Tracks that pass threshold rules will appear here for each enabled backend.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cola está vacía. Las pistas que cumplan las reglas de umbral aparecerán aquí para cada servicio activado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warteschlange ist leer. Tracks, die Schwellenwertregeln überschreiten, werden hier für jedes aktivierte Backend angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La file est vide. Des pistes qui passent les règles de seuil apparaîtront ici pour chaque moteur activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La coda è vuota. Le tracce che superano le regole di soglia verranno visualizzate qui per ogni backend abilitato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューは空です。 しきい値のルールを渡るトラックは、各有効なバックエンドにここに表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejka jest pusta. Dla każdego włączonego oparcia pojawią się tu utwory, które przechodzą zasady progowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A fila está vazia. As faixas que passam as regras de limiar aparecerão aqui para cada infra- estrutura ativada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очередь пуста. Треки, которые проходят пороговые правила, появятся здесь для каждого включенного бэкэнда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue är tom. Spår som passerar tröskelregler kommer att visas här för varje aktiverad backend."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue boş. Eşleme kurallarını geçen Tracks her etkinleştirilen arka uç için burada görünecektir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "腾讯为空. 通过阈值规则的音轨将在此为每个启用的后端显示 。"
          }
        }
      }
    },
