    "A guided setup path for the open music identity ListenScrobbler uses across submissions, charts, and diagnostics.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una configuración guiada de la identidad musical abierta que ListenScrobbler usa en envíos, gráficos y diagnósticos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein geführter Setup-Pfad für die offene Musikidentität, den ListenScrobbler über Einreichungen, Charts und Diagnosen hinweg verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chemin de configuration guidé pour l'identité musicale ouverte ListenScrobbler utilise à travers les soumissions, les graphiques et les diagnostics."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un percorso di configurazione guidato per l'identità musicale aperta ListenScrobbler utilizza attraverso presentazioni, grafici e diagnostica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開された音楽アイデンティティListenScrobbler用のガイド付きセットアップパスは、送信、チャート、および診断を通して使用されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prowadzona ścieżka konfiguracji dla otwartej tożsamości muzycznej ListenScrobbler wykorzystuje różne zgłoszenia, wykresy i diagnostykę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um caminho de configuração guiado para a identidade de música aberta ListenScrobbler usa em submissões, gráficos e diagnósticos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Путь настройки открытой музыкальной идентичности, который ListenScrobbler использует в представлениях, диаграммах и диагностике."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En guidad inställningsväg för den öppna musikidentiteten ListenScrobbler använder över inlämningar, diagram och diagnostik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık müzik kimliği ListenScrobbler için yol açan bir kurulum yolu, gönderimler, grafikler ve tanılar arasında kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于公开音乐身份ListenScrobbler的引导设置路径,跨越提交、图表和诊断。"
          }
        }
      }
    },
