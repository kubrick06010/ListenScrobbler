            "value": "La eliminación de ListenBrainz necesita una marca de tiempo de escucha y un MSID de grabación"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz Löschung benötigt einen Listen-Zeitstempel und Aufzeichnung MSID"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression ListenBrainz nécessite un horodatage d'écoute et l'enregistrement MSID"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz la cancellazione ha bisogno di un timestamp di ascolto e registrazione MSID"
