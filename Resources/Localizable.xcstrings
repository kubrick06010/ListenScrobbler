    "Use ListenBrainz's Add Data page for supported imports. ListenScrobbler does not require web music-service settings to submit local or manual listens.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la página Add Data de ListenBrainz para importaciones compatibles. ListenScrobbler no necesita ajustes web de servicios musicales para enviar escuchas locales o manuales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Add Data-Seite von ListenBrainz für unterstützte Importe. ListenScrobbler erfordert keine Einstellungen für Web-Musikdienste, um lokale oder manuelle Hörvorgänge einzureichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la page Add Data d'ListenBrainz pour les importations supportées. ListenScrobbler n'exige pas de paramètres de service de musique web pour soumettre des écoutes locales ou manuelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzare la pagina Aggiungi dati di ListenBrainz per le importazioni supportate. ListenScrobbler non richiede impostazioni di servizio web per inviare ascolti locali o manuali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz の [データの追加] ページを使用して、サポートされているインポートを行います。 ListenScrobbler は、ローカルまたはマニュアルリスニングを提出するために、Web ミュージックサービスの設定を必要としません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj strony ListenBrainz Add Data dla wspieranego importu. ListenScrobbler nie wymaga ustawień internetowych usług muzycznych do składania lokalnych lub ręcznych słuchaczy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a página Adicionar dados do ListenBrainz para importações suportadas. ListenScrobbler não requer configurações de serviço de música web para enviar escutas locais ou manuais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте страницу Добавить данные ListenBrainz для поддерживаемого импорта. ListenScrobbler не требует настройки музыкального сервиса для отправки локальных или ручных прослушиваний."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd ListenBrainzs Add Data-sida för stödd import. ListenScrobbler kräver inte att inställningarna för webbmusiktjänster skickar in lokala eller manuella lyssnar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen ithalat için ListenBrainz'nin Add Data sayfasını kullanın. ListenScrobbler, yerel veya manuel dinlemeler sunmak için web müzik servis ayarlarını gerektirmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持的导入使用 ListenBrainz 添加数据页面 。 ListenScrobbler不需要网络音乐服务设置来提交本地或手动的听觉."
          }
        }
      }
    },
    "Use a duration of at least 30 seconds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice una duración de al menos 30 segundos."
