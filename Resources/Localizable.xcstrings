    "Recent listens, now playing state, manual submissions, and library scans stay quick to reach.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las escuchas recientes, el estado de reproducción, los envíos manuales y los análisis de biblioteca siguen siempre a mano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Listens, jetzt Status, manuelle Einsendungen und Bibliotheksscans bleiben schnell zu erreichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les écoutes récentes, maintenant en jouant l'état, les soumissions manuelles, et les scans de bibliothèque restent rapides à atteindre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolti recenti, ora giocando stato, presentazioni manuali, e le scansioni di libreria rimangono veloci da raggiungere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のリスニング、現在、状態、マニュアルの投稿、およびライブラリのスキャンの再生はすぐに到達します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio słucha, teraz gra stan, manualne zgłoszenia, i skany biblioteki pozostają szybko dotrzeć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escutas recentes, agora jogando estado, submissões manuais, e varreduras de biblioteca ficar rápido para chegar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недавние прослушивания, теперь игра состояния, ручные представления и сканирование библиотеки остаются быстрыми."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyligen lyssnar, nu spelar statliga, manuella inlagor och biblioteksskanningar stannar snabbt för att nå."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son dinlemeler, şimdi devlet, manuel gönderimler oynuyor ve kütüphane taramaları ulaşmak için hızlı kalıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的收听,现在播放状态,人工提交,和库扫描保持快速到达."
          }
        }
      }
    },
