    "If Dock icon is hidden, the app starts silently in the menu bar on login.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el icono del Dock está oculto, la app se inicia discretamente en la barra de menús al iniciar sesión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Dock-Symbol ausgeblendet ist, startet die App beim Login lautlos in der Menüleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l'icône Dock est cachée, l'application démarre silencieusement dans la barre de menu sur la connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l'icona Dock è nascosta, l'app inizia silenziosamente nella barra dei menu di accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock アイコンが隠されている場合は、ログイン時にメニューバーにアプリがサイレントで起動します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli ikona Docka jest ukryta, aplikacja rozpoczyna się cicho w pasku menu podczas logowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o ícone Dock estiver oculto, a aplicação começa silenciosamente na barra de menus ao iniciar sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если иконка Dock скрыта, приложение начинается бесшумно в строке меню при входе в систему."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om Dock-ikonen är dold börjar appen tyst i menyfältet på inloggningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock icon gizliyse, uygulama giriş çubuğunda sessizce başlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Dock 图标被隐藏,则应用程序会在登录时的菜单栏中静悄悄地开始."
          }
        }
      }
    },
