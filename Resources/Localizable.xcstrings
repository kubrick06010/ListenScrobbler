    "MusicBrainz sign-in and ListenBrainz tokens avoid password storage while keeping your listening identity open.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tokens de inicio de sesión de MusicBrainz y ListenBrainz evitan el almacenamiento de contraseñas y mantienen abierta su identidad de escucha."
          }
        }
      }
    },
    "MusicBrainz tags": {
