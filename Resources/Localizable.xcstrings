    "Follow listeners, compare compatibility, exchange recommendations, and keep an eye on shared playlists from one place.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a oyentes, compara vuestra compatibilidad, intercambia recomendaciones y consulta playlists compartidas desde un solo lugar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgen Sie den Zuhörern, vergleichen Sie Kompatibilität, tauschen Sie Empfehlungen aus und behalten Sie gemeinsame Wiedergabelisten von einem Ort aus im Auge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez les auditeurs, comparez la compatibilité, échangez des recommandations et gardez un œil sur les playlists partagées d'un endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguire gli ascoltatori, confrontare la compatibilità, scambiare raccomandazioni e tenere d'occhio le playlist condivise da un posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リスナーをフォローし、互換性を比較し、推奨事項を交換し、1つの場所から共有プレイリストに目を向けます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź słuchaczy, porównuj kompatybilność, wymień zalecenia i obserwuj wspólne listy odtwarzania z jednego miejsca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga os ouvintes, compare compatibilidade, troque recomendações e mantenha um olho nas playlists compartilhadas de um lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следуйте за слушателями, сравнивайте совместимость, обменивайтесь рекомендациями и следите за общими плейлистами из одного места."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ lyssnare, jämför kompatibilitet, utbyta rekommendationer och håll ett öga på delade spellistor från en plats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinleyicileri takip edin, uyumluluk, değişim önerileri karşılaştırın ve tek bir yerden paylaşılan listelere göz kulak verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟踪听众,比较兼容性,交换建议,从一个地方监视共享播放列表."
          }
        }
      }
    },
