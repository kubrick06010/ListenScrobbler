    "ListenBrainz schedules deletions, so counts may update after the next hourly cleanup.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz programa las eliminaciones, asi que los recuentos pueden actualizarse tras la siguiente limpieza horaria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz plant Löschungen, so dass die Zählungen nach der nächsten stündlichen Bereinigung aktualisiert werden können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz planifie les suppressions, donc les nombres peuvent être mis à jour après le nettoyage horaire suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz programma le cancellazioni, quindi i conti possono aggiornare dopo la prossima pulizia oraria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz は削除をスケジュールするので、次の時間クリーンアップ後にカウントが更新されることがあります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwanie harmonogramów ListenBrainz, więc liczniki mogą być aktualizowane po następnym sprzątaniu godzinowym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz agenda exclusões, então conta pode atualizar após a próxima limpeza horária."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz-графики удаляются, поэтому подсчеты могут обновляться после следующей почасовой очистки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz scheman raderingar, så räknas kan uppdateras efter nästa timme rensning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz programları deletions, bu yüzden sayı önümüzdeki saat temizlendikten sonra güncellenebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz 计划删除, 因此计数可能在下一次小时清理后更新 。"
          }
        }
      }
    },
