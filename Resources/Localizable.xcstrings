        }
      }
    },
    "The selected language will be applied throughout ListenScrobbler after it restarts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Sprache wird nach dem Neustart in ganz ListenScrobbler angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma seleccionado se aplicará en todo ListenScrobbler después de reiniciarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue sélectionnée sera appliquée dans tout ListenScrobbler après son redémarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua selezionata verrà applicata a tutto ListenScrobbler dopo il riavvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した言語は、再起動後にListenScrobbler全体へ適用されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany język zostanie zastosowany w całym ListenScrobbler po ponownym uruchomieniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma selecionado será aplicado em todo o ListenScrobbler após reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный язык будет применён во всём ListenScrobbler после перезапуска."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det valda språket används i hela ListenScrobbler efter omstarten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen dil, yeniden başlatıldıktan sonra ListenScrobbler’ın tamamına uygulanacak."
