    "A combined view of ListenBrainz similarity and MusicBrainz relationships. Select a node to see why it is connected.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vista combinada de la similitud de ListenBrainz y las relaciones de MusicBrainz. Selecciona un nodo para ver por qué está conectado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kombinierte Ansicht von ListenBrainz Ähnlichkeit und MusicBrainz Beziehungen. Wählen Sie einen Knoten aus, um zu sehen, warum er verbunden ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vue combinée de la similitude ListenBrainz et des relations MusicBrainz. Sélectionnez un nœud pour voir pourquoi il est connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una visione combinata di somiglianza ListenBrainz e relazioni MusicBrainz. Selezionare un nodo per vedere perché è collegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz の類似性と MusicBrainz の関係を組み合わせたビュー。 接続しているノードを選択します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączny widok podobieństwa ListenBrainz i relacji MusicBrainz. Wybierz węzeł, aby zobaczyć dlaczego jest podłączony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma visão combinada da semelhança ListenBrainz e relações MusicBrainz. Selecione um nó para ver por que ele está conectado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комбинированный взгляд на сходство ListenBrainz и отношения MusicBrainz. Выберите узел, чтобы увидеть, почему он подключен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kombinerad bild av ListenBrainz likhet och MusicBrainz relationer. Välj en nod för att se varför den är ansluten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz benzerliği ve MusicBrainz ilişkilerinin bir araya gelmesi. Neden bağlantılı olduğunu görmek için bir node seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz相似性和MusicBrainz关系的综合观点. 选择一个节点来查看它为什么被连接 。"
          }
        }
      }
    },
    "A familiar listening timeline": {
      "localizations": {
        "es": {
