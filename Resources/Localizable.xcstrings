          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A identidade ListenScrobbler primária para submissões, gráficos e dados de música social."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основная идентификация ListenScrobbler для представлений, диаграмм и данных социальной музыки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
