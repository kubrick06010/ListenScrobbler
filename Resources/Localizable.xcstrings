    "Connect ListenBrainz in Preferences to unlock open archive charts, recent listens, and cross-platform history.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta ListenBrainz en Ajustes para acceder a gráficos del historial abierto, escuchas recientes e historial multiplataforma."
          }
        },
        "de": {
          "stringUnit": {
