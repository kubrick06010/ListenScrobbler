    "Open your ListenBrainz profile, copy the user token, paste it into the User token field, then choose Save & Validate.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra su perfil de ListenBrainz, copie el token de usuario, péguelo en el campo Token de usuario y luego elija Guardar y validar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Ihr ListenBrainz-Profil, kopieren Sie das Benutzer-Token, fügen Sie es in das Benutzer-Token-Feld ein und wählen Sie dann Speichern und Validieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez votre profil ListenBrainz, copiez le jeton utilisateur, collez-le dans le champ Jeton utilisateur, puis choisissez Enregistrer et Valider."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il tuo profilo ListenBrainz, copia il token dell'utente, incollalo nel campo Token dell'utente, quindi scegli Salva e convalida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainzプロファイルを開き、ユーザートークンをコピーし、ユーザートークンフィールドに貼り付け、保存&検証を選択します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz swój profil ListenBrainz, skopiuj token użytkownika, wklej go w pole token użytkownika, a następnie wybierz Zapisz & Potwierdź."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra seu perfil ListenBrainz, copie o token do usuário, cole-o no campo Token do Usuário e selecione Salvar e validar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте свой ListenBrainz-профиль, скопируйте пользовательский токен, вставьте его в поле User token, затем выберите Save & Validate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna din ListenBrainz-profil, kopiera användartoken, klistra in den i fältet Användartoken, välj sedan Spara och validera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz profilinizi açın, kullanıcıyı token kopyalayın, onu Kullanıcı token alanına yapıştırın, sonra Save & Validate'yi seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开您的 ListenBrainz 配置文件, 复制用户令牌, 粘贴到用户令牌字段, 然后选择保存和验证 。"
          }
        }
      }
    },
