            "value": "Wählen Sie jemanden, dem Sie folgen, jemanden, der Ihnen folgt, oder einen ähnlichen Benutzer, um Ihren offenen Hörverlauf zu vergleichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez quelqu'un que vous suivez, quelqu'un qui vous suit ou un utilisateur similaire pour comparer votre historique d'écoute ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli qualcuno che segua, qualcuno che ti segue, o un utente simile per confrontare la tua cronologia di ascolto aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローしている人、フォローしている人、または同様のユーザーを選択して、オープンリスニング履歴を比較します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kogoś, kogo śledzisz, kogoś, kto cię śledzi, lub podobnego użytkownika, aby porównać otwartą historię słuchania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha alguém que você siga, alguém que o siga ou um usuário similar para comparar seu histórico de audição aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите кого-то, за кем вы следуете, кого-то, кто следует за вами, или аналогичного пользователя, чтобы сравнить вашу открытую историю прослушивания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj någon du följer, någon som följer dig eller en liknande användare att jämföra din öppna lyssnarhistorik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takip ettiğiniz birini seçin, sizi takip eden biri veya açık dinleme tarihinizi karşılaştırmak için benzer bir kullanıcı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一个跟踪你的人 跟踪你的人 或类似的用户来比较你公开的监听历史"
          }
        }
      }
    },
