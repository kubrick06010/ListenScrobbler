    "Play music in a supported player. ListenScrobbler will show the current track here and submit it when it reaches the listening threshold.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce música en un reproductor compatible. ListenScrobbler mostrará aquí la pista actual y la enviará cuando alcance el umbral de escucha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik in einem unterstützten Player abspielen. ListenScrobbler wird den aktuellen Track hier zeigen und einreichen, wenn er die Hörschwelle erreicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez de la musique dans un lecteur pris en charge. ListenScrobbler affichera la piste actuelle ici et la soumettra quand elle atteindra le seuil d'écoute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona musica in un lettore supportato. ListenScrobbler mostrerà la traccia attuale qui e la sottopone quando raggiunge la soglia di ascolto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートされているプレーヤーで音楽を再生します。 ここでListenScrobblerは現在のトラックを表示し、リスニングのしきい値に達するとそれを提出します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Graj muzykę w obsługiwanym odtwarzaczu. ListenScrobbler pokaże bieżącą ścieżkę tutaj i przedstawi ją, gdy osiągnie próg słuchania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduzir música num reprodutor suportado. O ListenScrobbler mostrará aqui a faixa atual e a enviará quando atingir o limiar de audição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играйте музыку в поддерживаемом плеере. ListenScrobbler покажет текущий трек и отправит его, когда он достигнет порога прослушивания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela musik i en stödd spelare. ListenScrobbler kommer att visa det aktuella spåret här och lämna in det när det når lyssningströskeln."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen bir oyuncuda müzik oynayın. ListenScrobbler, şu anki pisti burada gösterecek ve onu dinleme eşine ulaştığında gönderecektir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在支持的播放器中播放音乐. ListenScrobbler 将在此显示当前音轨, 并在它达到监听阈值时提交 。"
          }
        }
      }
    },
