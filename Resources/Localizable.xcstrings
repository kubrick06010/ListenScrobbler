    "With a %@%% mainstream score, you are %@ compared to your recent baseline.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "With a %@%% mainstream score, you are %@ compared to your recent baseline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un índice de popularidad del %@ %%, estás %@ respecto a tu referencia reciente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem %@%% Mainstream-Score sind Sie %@ im Vergleich zu Ihrer letzten Baseline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un score %@%% mainstream, vous êtes %@ par rapport à votre point de départ récent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un punteggio principale %@%%, sei %@ rispetto alla tua recente linea di base."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%% の主流スコアで、最近のベースラインと比較して %@ です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z punktacji %@%% głównego nurtu, jesteś %@ w porównaniu z ostatnim bazowym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma%@%%pontuação mainstream, você é%@em comparação com a sua linha de base recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С основным баллом %@%% вы являетесь %@ по сравнению с вашим последним базовым уровнем."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med en %@%% mainstream-poäng är du %@ jämfört med din senaste baslinje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%% ana puanı ile, son bazline kıyasla %@siniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%% 主流得分, 您是 %@ 与您最近的基线相比 。"
          }
        }
      }
    },
