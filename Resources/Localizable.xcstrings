    "MusicBrainz sign-in and ListenBrainz tokens avoid password storage while keeping your listening identity open.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tokens de inicio de sesión de MusicBrainz y ListenBrainz evitan el almacenamiento de contraseñas y mantienen abierta su identidad de escucha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz-Anmeldung und ListenBrainz-Token vermeiden die Passwortspeicherung und halten Ihre Höridentität offen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jetons MusicBrainz et ListenBrainz évitent le stockage des mots de passe tout en gardant votre identité d'écoute ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I token MusicBrainz e ListenBrainz evitano l'archiviazione delle password mantenendo aperta la tua identità di ascolto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz サインインと ListenBrainz トークンは、あなたのリスニング ID を開いたままパスワードストレージを避けます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz signing- in i żetony ListenBrainz unikają przechowywania hasła przy jednoczesnym zachowaniu otwartej tożsamości słuchania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tokens MusicBrainz e ListenBrainz evitam o armazenamento de senhas mantendo sua identidade de escuta aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Токены входа в MusicBrainz и ListenBrainz избегают хранения паролей, сохраняя при этом вашу личность прослушивания открытой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz inloggning och ListenBrainz tokens undviker lösenord lagring medan du håller din lyssningsidentitet öppen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz işareti-in ve ListenBrainz jetonları dinleme kimliğinizi açık tutarken şifre depolamalarından kaçınır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz 签名和 ListenBrainz 令牌在保持监听身份的同时避免密码存储."
          }
        }
      }
    },
