    "ListenBrainz is the primary destination for now playing, completed listens, charts, and open social discovery.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz es el destino principal para la reproducción actual, las escuchas completadas, los gráficos y el descubrimiento social abierto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz ist das primäre Ziel für das Spielen, abgeschlossene Hören, Charts und offene soziale Entdeckungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz est la destination principale pour jouer, écouter, cartographier et ouvrir la découverte sociale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz è la destinazione principale per ora giocare, completare ascolti, grafici e scoperta sociale aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz は、再生、リスニング、チャートの完成、およびソーシャルディスカバリーの開始の主要目的地です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz jest głównym celem gry, zakończonych słuchań, wykresów i otwartego odkrycia społecznego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz é o destino principal para agora tocar, completar escutas, gráficos e descoberta social aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz является основным местом для игры, прослушивания, диаграмм и открытых социальных открытий."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz är den primära destinationen för att nu spela, slutföra lyssnar, diagram och öppen social upptäckt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz şimdi oyun için birincil hedef, dinleyiciler, grafikler ve açık sosyal keşifler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz是现在游戏,完成的听觉,图表,以及开放的社会发现的主要目的地."
          }
        }
      }
    },
    "ListenBrainz pin": {
      "localizations": {
        "es": {
          "stringUnit": {
