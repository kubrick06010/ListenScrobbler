    "Corporate-friendly proxy controls applied centrally to music service requests.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controles de proxy amigables para las empresas aplicados centralmente a las solicitudes de servicios de música."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unternehmensfreundliche Proxy-Kontrollen werden zentral auf Musikdienstanfragen angewendet."
          }
        },
        "fr": {
          "stringUnit": {
