    "ListenBrainz uses your MusicBrainz account. Sign in on the web first so the token page can show your account token.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz usa tu cuenta de MusicBrainz. Inicia sesión primero en la web para que la página del token pueda mostrar tu token de cuenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz verwendet Ihr MusicBrainz-Konto. Melden Sie sich zuerst im Web an, damit die Token-Seite Ihr Konto-Token anzeigen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz utilise votre compte MusicBrainz. Connectez-vous sur le web d'abord afin que la page de jeton puisse afficher votre jeton de compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz utilizza il tuo account MusicBrainz. Accedi prima sul web in modo che la pagina di token possa mostrare il token del tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz は MusicBrainz アカウントを使用します。 Web上で最初にサインインすると、トークンページがアカウントトークンを表示できるようにします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz używa twojego konta MusicBrainz. Zaloguj się najpierw w sieci, aby strona token mogła pokazać twój token konta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz usa sua conta MusicBrainz. Entre na web primeiro para que a página token possa mostrar seu token de conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz использует учетную запись MusicBrainz. Войдите в Интернет первым, чтобы страница токена могла показать токен вашей учетной записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz använder ditt MusicBrainz-konto. Logga in på webben först så att tokensidan kan visa ditt konto token."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz MusicBrainz hesabınızı kullanır. İlk önce web'de oturum açın, böylece token sayfası hesabınızı kontrol edebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ListenBrainz使用你的MusicBrainz账户. 首先在网络上签名,以便令牌页面显示您的账户令牌."
          }
        }
      }
    },
