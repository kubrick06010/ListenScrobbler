    "Share with another app user by exporting a `.listenscrobbler-shared.json` bundle, or move track-based shares into portable `.jspf` playlists with MusicBrainz identifiers when available.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte con otro usuario de la app exportando un paquete `.listenscrobbler-shared.json`, o convierte las pistas compartidas en playlists `.jspf` portátiles con identificadores de MusicBrainz cuando estén disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie mit einem anderen App-Benutzer, indem Sie ein `.listenscrobbler-shared.json`-Bundle exportieren, oder verschieben Sie Track-basierte Shares in tragbare `.jspf`-Wiedergabelisten mit MusicBrainz-Kennungen, wenn verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez avec un autre utilisateur de l'application en exportant un paquet `.listenscrobbler-shared.json`, ou déplacez des actions basées sur des pistes dans des listes de lecture `.jspf` portables avec des identifiants MusicBrainz lorsque disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividere con un altro utente app esportando un bundle `.listenscrobbler-shared.json` o spostando le azioni basate su binario in playlist portatili `.jspf` con identificatori MusicBrainz quando disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`.listenscrobbler-shared.json` バンドルをエクスポートしたり、トラックベースの共有をMusicBrainz IDでポータブル `.jspf` プレイリストに移動したりすることで、別のアプリユーザーと共有できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podziel się z innym użytkownikiem aplikacji, eksportując pakiet '.listenscrobbler- Shared.json' lub przenieś akcje oparte na track- Based do przenośnych list odtwarzania '.jspf' z identyfikatorami MusicBrainz, jeśli są dostępne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe com outro usuário de aplicativos exportando um pacote `.listenscrobbler-shared.json`, ou mova compartilhamentos baseados em faixas para playlists portáteis `.jspf` com identificadores MusicBrainz quando disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь с другим пользователем приложения, экспортируя пакет «.listenscrobbler-shared.json» или переместите трековые акции в портативные плейлисты «.jspf» с идентификаторами MusicBrainz, когда они доступны."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela med en annan appanvändare genom att exportera ett `.listenscrobbler-shared.json`-paket eller flytta spårbaserade aktier till bärbara `.jspf`-spellistor med MusicBrainz-identifierare när de är tillgängliga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir \".listenscrobbler-shared.json'un paketlerini ihraç ederek başka bir uygulama kullanıcısıyla paylaşın veya mevcut olduğunda MusicBrainz tanımlayıcıları ile birlikte takip tabanlı hisseleri hareket edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
